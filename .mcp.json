{
  "mcpServers": {
    "march-madness": {
      "command": "python3",
      "args": ["mcp_server.py"],
      "cwd": "/Users/benrosen/march-madness-forecaster"
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless"]
    },
    "tavily": {
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    }
  }
}
