# Kaggle API credentials
# Get your key at https://www.kaggle.com/settings → API → Create New Token
# Required for downloading MMasseyOrdinals.csv (50-160+ ranking systems)
# which is the single highest-signal feature in the competition.
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_key_here

# CBBData credentials (optional — enables cbbdata.com API for Torvik data)
# Register free at https://cbbdata.aweatherman.com
# The scraper will log in automatically and cache the token for the session.
# Without these, the scraper falls back to barttorvik.com CSV endpoints.
CBD_USER=your_cbbdata_username_here
CBD_PASSWORD=your_cbbdata_password_here

# The Odds API credentials (optional)
# Register free at https://the-odds-api.com (500 requests/month, no credit card)
# Used by TheOddsAPIScraper to pull aggregated sportsbook odds (40+ bookmakers)
THE_ODDS_API_KEY=your_the_odds_api_key_here
