{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/espn_pool_bracket.schema.json",
  "title": "ESPN Pool Bracket Artifact",
  "description": "Minimal validity-first contract for output of `espn-bracket-export`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "pool_size",
    "recommended_strategy",
    "primary_bracket",
    "source_report"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "const": "ev"
    },
    "pool_size": {
      "type": "integer",
      "minimum": 1
    },
    "recommended_strategy": {
      "type": "string"
    },
    "primary_bracket": {
      "type": "object",
      "description": "Primary bracket payload selected from EV pareto output.",
      "additionalProperties": true
    },
    "source_report": {
      "type": "string",
      "minLength": 1
    }
  }
}
