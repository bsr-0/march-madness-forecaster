if (!window.getComputedStyle) {
	window.getComputedStyle = function(el, pseudo) {
		this.el = el;
		this.getPropertyValue = function(prop) {
			var re = /(\-([a-z]){1})/g;
			if (prop == 'float') prop = 'styleFloat';
			if (re.test(prop)) {
				prop = prop.replace(re, function () {
					return arguments[2].toUpperCase();
				});
			}
			return el.currentStyle[prop] ? el.currentStyle[prop] : null;
		}
		return this;
	}
}
/* IE8 */

window.onerror = function(msg, url, line) {
	window._jsError = true;
	window._jsErrors = window._jsErrors || [];
	window._jsErrors.push({
		msg: msg,
		url: url,
		line: line
	});
};

espn = {
	core: {},
	fantasy: {
		maxpart: {
			ads: {
				_ads: [],
				_asyncRequests: [],
				_getElement_Ad: function(ad) {
					var selector = espn.fantasy.maxpart.ads._selector(ad);
					return document.getElementById(selector.replace('#', ''));
				},
				_getElement_AdWrap: function(ad) {
					var selector = espn.fantasy.maxpart.ads._selector(ad);
					return document.getElementById(selector.replace('#', '') + '_wrap');
				},
				_iframeDoc: function(iframe) {
					var contentWindow = (iframe.contentWindow) ? iframe.contentWindow : (iframe.contentDocument.document) ? iframe.contentDocument.document : iframe.contentDocument;
					return contentWindow.document;
				},
				_iframeHasContent: function(iframe) {
					var hasContent = false;

					if (iframe !== null) {
						var children = espn.fantasy.maxpart.ads._iframeDoc(iframe).body.children;

						for (var i = 0, iLen = children.length; i < iLen; i++) {
							var child = children[i];

							if (child.nodeName.toLowerCase() !== 'script') {
								hasContent = true;
								break;
							}
						}
					}

					return hasContent;
				},
				_iframeLoaded: function(iframeID) {
					var iframe = document.getElementById(iframeID);

					if (iframe !== null) {
						if (espn.fantasy.maxpart.ads._iframeHasContent(iframe)) {
							iframe.parentElement.style.display = "block";
						} else {

						}
					}
				},
				_iframe: function(adWrapElement, adUri, type, size) {
					if (adWrapElement !== null) {
						size = size.split(',')[0];

						var dimensions = size.split('x'),
							width = dimensions[0],
							height = dimensions[1],
							id = adWrapElement.id.replace('_wrap', '_iframe'),
							html = '<iframe src="about:blank" id="' + id + '" class="adslot" scrolling="no" frameborder="0" marginwidth="0px" marginheight="0px" style="width:' + width + 'px;height:' + height + 'px;display:block;" width="' + width + 'px" height="' + height + 'px"></iframe>';

						adWrapElement.innerHTML = html;

						var iframe = document.getElementById(id);

						if (iframe !== null) {
							try {
								var doc = espn.fantasy.maxpart.ads._iframeDoc(iframe);

								var color = "transparent";

								//if (ifrm.id == "incontent") {
								//	color = "#FFF";
								//}

								var content;
								content = "<!DOCTYPE html>";
								content += "<head>";
								content += "<style type='text/css'>body{background-color:" + color + ";}body>div{text-align:center;}img[width='1'],img[width='5']{display:none;}a img{border: none;}</style>";
								content += "<base target='_top'/>";
								content += "</head>";
								content += "<body>";
								content += "<scr" + "ipt>var inDapIF=true;</scr" + "ipt>";
								content += "<scr" + "ipt type='text/javascript' src='" + adUri + "'></scr" + "ipt>";
								content += "<scr" + "ipt type='text/javascript'>window.onload = function() {parent.espn.fantasy.maxpart.ads._iframeLoaded('" + id + "');}</scr" + "ipt>";
								content += "</body>";
								content += "</html>";

								doc.open().write(content);

								//doc.close();
								setTimeout(function(){doc.close();}, 1000);
							} catch(e) {
								console.log(e);
							}
						}
					}
				},
				_insertAd: function(ad) {
					var adWrapElement = espn.fantasy.maxpart.ads._getElement_AdWrap(ad);

					if (adWrapElement !== null) {
						var inserted = ad.inserted;

						if ((typeof ad.inserted === 'undefined') || (!inserted)) {
							var adRequest = espn.fantasy.maxpart.util.JSON.clone(ad.details),
								adUri = espn.fantasy.maxpart.ads._siteAndZone() + ';',
								swid='',
								tracking = ad.tracking;

							adRequest.ord = this._ord;  //shared across ad requests
							adRequest.gm = tracking.gm;
							adRequest.pgn = tracking.pgn;
							adRequest.pos = tracking.pos;

							if (espn.fantasy.maxpart.util.device.isDesktop()) {
								adRequest.lang = tracking.lang;

								var uParam = '';

								for (var tKey in tracking) {
									uParam += tKey + "=" + tracking[tKey] + "|";
								}
								adRequest.u = 'swid=' + swid + '|' + uParam;
							} else {
								adRequest.common = true;
								adRequest.display = true;
								adRequest.isIndexPage = false;
								adRequest.mnr = (espn.fantasy.maxpart.util.cookies.read("grif")) ? 't' : 'f';
								adRequest.msite = (espn.fantasy.maxpart.util.device.isTablet()) ? 'tablet' : 'touch';
								adRequest.swid = swid;
							}

							for (var arKey in adRequest) {
								adUri += arKey + "=" + adRequest[arKey] + ";";
							}

							espn.fantasy.maxpart.ads._iframe(adWrapElement, 'http://ad.doubleclick.net/adj/' + adUri, adRequest.pos, adRequest.sz);
							ad.inserted = true;
						}
					}
				},
				_insertNewAds: false,
				_ord: Math.floor(Math.random() * 10000000000),
				_refreshAd: function(ad) {
					var element = espn.fantasy.maxpart.ads._getElement_Ad(ad);

					if (element !== null) {
						if (espn.fantasy.maxpart.util.DOM.element.isVisible(element)) {
							espn.fantasy.maxpart.ads._insertAd(ad);
						} else {
							espn.fantasy.maxpart.ads._removeAd(ad);
						}
					}
				},
				_removeAd: function(ad) {
					var adWrapElement = espn.fantasy.maxpart.ads._getElement_AdWrap(ad);

					if (adWrapElement !== null) {
						adWrapElement.style.display = "none";

						while (adWrapElement.firstChild) {
							adWrapElement.removeChild(adWrapElement.firstChild);
						}

						var grandParent = adWrapElement.parentElement.parentElement;

						if (grandParent.id === 'div_incontent') {
							grandParent.style.display = "block";
						}
					}

					ad.inserted = false;
				},
				_requestInProgress: false,
				_selector: function(ad) {
					return '#ad_' + ad.tracking.pos;
				},
				_siteName: 'espn.us.com.games',
				_siteName_Mobile: 'm.espn.us.com.games',
				_zone: 'basketball',
				_siteAndZone: function() {
					var site = espn.fantasy.maxpart.ads._siteName,
						zone = espn.fantasy.maxpart.ads._zone;
					
					if (espn.fantasy.maxpart.util.device.layout() !== 'desktop') {
						site = espn.fantasy.maxpart.ads._siteName_Mobile;
					}
					
					return site + '/' + zone;
				},
				initAd: function(details, tracking) {
					var ad = {'details':details,'tracking':tracking};

					espn.fantasy.maxpart.ads._ads[espn.fantasy.maxpart.ads._ads.length] = ad;

					if (espn.fantasy.maxpart.ads._insertNewAds) {
						espn.fantasy.maxpart.ads._insertAd(ad);
					}

					return ad;
				},
				load: function() {
					espn.fantasy.maxpart.ads.refresh();
				},
				refresh: function() {
					var ads = espn.fantasy.maxpart.ads._ads;
					for (var i = 0; i < ads.length; i++) {
						var ad = ads[i],
							element = espn.fantasy.maxpart.ads._getElement_Ad(ad);

						if (element !== null) {
							espn.fantasy.maxpart.ads._refreshAd(ad);
						} else {
							// Lets remove the ad
							ads.splice(i, 1);
						}
					}
					espn.fantasy.maxpart.ads._insertNewAds = true;
				}
			},
			game: {
				sport: 'basketball'
			},
			util: {
				cookies: {
					read: function(name) {
						var nameEQ = name + "=",
							ca = document.cookie.split(';');

						for (var i=0,iLen=ca.length;i<iLen;i++) {
							var c = ca[i];
							while (c.charAt(0)==' ') c = c.substring(1,c.length);
							if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length,c.length);
						}
						return null;
					}
				},
				debug: function() {
					if (typeof this._debugMode === 'undefined') {
						this._debugMode = (typeof window.espn.fantasy.maxpart.util.URLParamHash('debug') !== 'undefined');
					}

					return this._debugMode;
				},
				device: {
					isDesktop: function() {
						return (espn.fantasy.maxpart.util.device.layout() === 'desktop');
					},
					isMobile: function() {
						return (!espn.fantasy.maxpart.util.device.isDesktop());
					},
					isHandset: function() {
						return (espn.fantasy.maxpart.util.device.layout() === 'handset');
					},
					isTablet: function() {
						return (espn.fantasy.maxpart.util.device.layout() === 'tablet');
					},
					isTouch: function() {
						var touch = false;

						if (typeof Modernizr !== 'undefined') {
							touch = Modernizr.touch;
						} else {
							// what to do here...
						}

						return touch;
					},
					layout: function() {
						var content = window.getComputedStyle(document.body, ':after').getPropertyValue('content');
						return (content !== null) ? content.replace(/(\"|\')/g, '') : 'mobile'; // IE8 doesn't support this... fallback to mobile
					}
				},
				DOM: {
					element: {
						isVisible: function(element) {
							return ((element !== null) && (element.offsetParent !== null));
						}
					}
				},
				JSON: {
					clone: function(json) {
						return espn.fantasy.maxpart.util.JSON.extend(true, {}, json);
					},
					extend: function() {
						var options, name, src, copy, copyIsArray, clone,
							target = arguments[0] || {},
							i = 1,
							length = arguments.length,
							deep = false;

						// Handle a deep copy situation
						if (typeof target === "boolean") {
							deep = target;

							// Skip the boolean and the target
							target = arguments[i] || {};
							i++;
						}

						// Handle case when target is a string or something (possible in deep copy)
						if (typeof target !== "object" && !espn.fantasy.maxpart.util.object.isFunction(target)) {
							target = {};
						}

						// Extend jQuery itself if only one argument is passed
						if (i === length) {
							target = this;
							i--;
						}

						for (; i < length; i++) {
							// Only deal with non-null/undefined values
							if ((options = arguments[ i ]) != null ) {
							// Extend the base object
								for (name in options) {
									src = target[name];
									copy = options[name];

									// Prevent never-ending loop
									if (target === copy) {
										continue;
									}

									// Recurse if we're merging plain objects or arrays
									if (deep && copy && (espn.fantasy.maxpart.util.object.isPlain(copy) || (copyIsArray = espn.fantasy.maxpart.util.object.isArray(copy)))) {
										if (copyIsArray) {
											copyIsArray = false;
											clone = src && espn.fantasy.maxpart.util.object.isArray(src) ? src : [];
										} else {
											clone = src && espn.fantasy.maxpart.util.object.isPlain(src) ? src : {};
										}

										// Never move original objects, clone them
										target[name] = espn.fantasy.maxpart.util.object.extend(deep, clone, copy);

									// Don't bring in undefined values
									} else if (copy !== undefined) {
										target[name] = copy;
									}
