					}()),
					isArray: Array.isArray,
					isFunction: function(obj) {
						return espn.fantasy.maxpart.util.object.type(obj) === "function";
					},
					isPlain: function(obj) {
						// Not plain objects:
						// - Any object or value whose internal [[Class]] property is not "[object Object]"
						// - DOM nodes
						// - window
						if (espn.fantasy.maxpart.util.object.type(obj) !== "object" || obj.nodeType || espn.fantasy.maxpart.util.object.isWindow(obj)) {
							return false;
						}

