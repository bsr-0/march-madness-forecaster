	<table class="wpw-table" cellpadding="2" cellspacing="1">
		<thead>
			<tr class="table-header">
				<td align="center" colspan="6">2012 NCAA Men's Tournament</td>
			</tr>
			<tr class="table-subheader">
				<td>Round of 64</td>
				<td>Round of 32</td>
				<td>Sweet 16</td>
				<td>Elite Eight</td>
				<td>Final Four</td>
				<td>Championship</td>
			</tr>
