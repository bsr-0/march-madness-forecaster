/* Polyfills */
/* IE8 */
if (!window.getComputedStyle) {
	window.getComputedStyle = function(el, pseudo) {
		this.el = el;
		this.getPropertyValue = function(prop) {
			var re = /(\-([a-z]){1})/g;
			if (prop == 'float') prop = 'styleFloat';
			if (re.test(prop)) {
				prop = prop.replace(re, function () {
					return arguments[2].toUpperCase();
				});
			}
			return el.currentStyle[prop] ? el.currentStyle[prop] : null;
		}
		return this;
	}
}
/* IE8 */

window.onerror = function(msg, url, line) {
	window._jsError = true;
	window._jsErrors = window._jsErrors || [];
	window._jsErrors.push({
		msg: msg,
		url: url,
		line: line
	});
};

espn = {
	core: {},
	fantasy: {
		maxpart: {
			game: {
				sport: 'fantasy'
			},
			util: {
				cookies: {
					read: function(name) {
						var nameEQ = name + "=",
							ca = document.cookie.split(';');

						for (var i=0,iLen=ca.length;i<iLen;i++) {
							var c = ca[i];
							while (c.charAt(0)==' ') c = c.substring(1,c.length);
							if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length,c.length);
						}
						return null;
					}
				},
				debug: function() {
					if (typeof this._debugMode === 'undefined') {
						this._debugMode = (typeof window.espn.fantasy.maxpart.util.URLParamHash('debug') !== 'undefined');
					}

					return this._debugMode;
				},
				device: {
					isDesktop: function() {
						return (espn.fantasy.maxpart.util.device.layout() === 'desktop') || (espn.fantasy.maxpart.util.device.layout() === 'desktop-lg');
					},
					isMobile: function() {
						return (!espn.fantasy.maxpart.util.device.isDesktop());
					},
					isHandset: function() {
						return (espn.fantasy.maxpart.util.device.layout() === 'mobile');
					},
					isTablet: function() {
						return (espn.fantasy.maxpart.util.device.layout() === 'tablet');
					},
					isTouch: function() {
						var touch = false;

						if (typeof Modernizr !== 'undefined') {
							touch = Modernizr.touch;
						} else {
							// what to do here...
						}

						return touch;
					},
					layout: function() {
						var content = window.getComputedStyle(document.body, ':after').getPropertyValue('content');
						return (content !== null) ? content.replace(/(\"|\')/g, '') : 'mobile'; // IE8 doesn't support this... fallback to mobile
					}
				},
				DOM: {
					element: {
						isVisible: function(element) {
							return ((element !== null) && (element.offsetParent !== null));
						}
					}
				},
				JSON: {
					clone: function(json) {
						if (typeof jQuery === 'undefined') {
							return JSON.parse(JSON.stringify(json)); // Won't clone functions or other non-serializable items
						} else {
							return jQuery.extend(true, {}, json);
						}
					}
				},
				URLParamHash: function(hashKey) {
					/* Window URL params as map */
					if (typeof this._hash === 'undefined') {
						this._hash = {};

						var pairs = window.location.search.substring(1).split('&');

						for (var p=0; p<pairs.length; ++p) {
							var pair = pairs[p].split('=');
							if (pair.length === 2) {
								var key = pair[0], val = pair[1];
								if (val === parseInt(val, 10)) {
									val = parseInt(val, 10);
								}
								this._hash[key] = val;
							}
						}
					}

					return this._hash[hashKey];
				}
			}
		}
	}
};

var mp = espn.fantasy.maxpart;</script>


